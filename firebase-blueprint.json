{
  "entities": {
    "Patient": {
      "title": "Patient",
      "description": "Hospital patient demographic and clinical admission record",
      "type": "object",
      "properties": {
        "patientId": {
          "type": "string",
          "description": "Unique identifier for patient e.g. PAT-2026-001",
          "pattern": "^[A-Za-z0-9-]+$",
          "maxLength": 32
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the patient",
          "maxLength": 100
        },
        "age": {
          "type": "number",
          "description": "Age in years"
        },
        "gender": {
          "type": "string",
          "description": "Gender of patient",
          "enum": ["Male", "Female", "Other"]
        },
        "bloodGroup": {
          "type": "string",
          "description": "Blood group code",
          "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-", "Unknown"]
        },
        "phone": {
          "type": "string",
          "description": "Contact telephone or mobile number",
          "maxLength": 20
        },
        "email": {
          "type": "string",
          "description": "Email address of patient or guardian",
          "maxLength": 120
        },
        "address": {
          "type": "string",
          "description": "Residential address",
          "maxLength": 300
        },
        "medicalHistory": {
          "type": "string",
          "description": "Past medical conditions, diagnoses or surgical history",
          "maxLength": 1000
        },
        "allergies": {
          "type": "string",
          "description": "Known drug or food allergies",
          "maxLength": 500
        },
        "emergencyContact": {
          "type": "string",
          "description": "Emergency contact name and phone",
          "maxLength": 120
        },
        "registrationDate": {
          "type": "string",
          "description": "Date of hospital registration (YYYY-MM-DD)",
          "maxLength": 30
        },
        "registeredBy": {
          "type": "string",
          "description": "User UID who registered the patient",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 50
        }
      },
      "required": ["patientId", "fullName", "age", "gender", "phone", "bloodGroup", "registrationDate"]
    },
    "Doctor": {
      "title": "Doctor",
      "description": "Attending physician and clinical specialist details",
      "type": "object",
      "properties": {
        "doctorId": {
          "type": "string",
          "description": "Unique identifier for doctor e.g. DOC-101",
          "pattern": "^[A-Za-z0-9-]+$",
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "description": "Doctor full title and name",
          "maxLength": 100
        },
        "specialization": {
          "type": "string",
          "description": "Medical specialty",
          "maxLength": 100
        },
        "qualification": {
          "type": "string",
          "description": "Degrees and board credentials e.g. MBBS, MD",
          "maxLength": 100
        },
        "department": {
          "type": "string",
          "description": "Hospital department",
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "Doctor direct contact number",
          "maxLength": 20
        },
        "email": {
          "type": "string",
          "description": "Professional email address",
          "maxLength": 120
        },
        "availability": {
          "type": "string",
          "description": "Working days and shift schedule",
          "maxLength": 200
        },
        "roomNumber": {
          "type": "string",
          "description": "Clinic consulting room / OPD number",
          "maxLength": 30
        },
        "status": {
          "type": "string",
          "description": "Availability status",
          "enum": ["Active", "On Leave", "Inactive"]
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 50
        }
      },
      "required": ["doctorId", "name", "specialization", "phone", "availability", "department"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Scheduled clinic consultation between patient and doctor",
      "type": "object",
      "properties": {
        "appointmentId": {
          "type": "string",
          "description": "Unique identifier for appointment e.g. APT-2026-001",
          "pattern": "^[A-Za-z0-9-]+$",
          "maxLength": 32
        },
        "patientId": {
          "type": "string",
          "description": "Referenced patient ID",
          "maxLength": 64
        },
        "patientName": {
          "type": "string",
          "description": "Patient full name cache",
          "maxLength": 100
        },
        "doctorId": {
          "type": "string",
          "description": "Referenced doctor ID",
          "maxLength": 64
        },
        "doctorName": {
          "type": "string",
          "description": "Doctor name cache",
          "maxLength": 100
        },
        "department": {
          "type": "string",
          "description": "Hospital department for appointment",
          "maxLength": 100
        },
        "appointmentDate": {
          "type": "string",
          "description": "Date of appointment (YYYY-MM-DD)",
          "maxLength": 30
        },
        "timeSlot": {
          "type": "string",
          "description": "Appointment time e.g. 10:30 AM",
          "maxLength": 30
        },
        "reason": {
          "type": "string",
          "description": "Chief clinical complaint or consultation reason",
          "maxLength": 500
        },
        "priority": {
          "type": "string",
          "description": "Priority tier of visit",
          "enum": ["Routine", "Urgent", "Follow-up", "Emergency"]
        },
        "status": {
          "type": "string",
          "description": "Appointment progress status",
          "enum": ["Scheduled", "In-Progress", "Completed", "Cancelled"]
        },
        "cancellationReason": {
          "type": "string",
          "description": "Reason for cancellation if cancelled",
          "maxLength": 300
        },
        "notes": {
          "type": "string",
          "description": "Clinical follow-up notes or prescription recommendations",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 50
        }
      },
      "required": ["appointmentId", "patientId", "doctorId", "appointmentDate", "timeSlot", "reason", "status"]
    },
    "StaffAdmin": {
      "title": "StaffAdmin",
      "description": "Authorized hospital administration or medical staff record",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Staff login email",
          "maxLength": 120
        },
        "displayName": {
          "type": "string",
          "description": "Staff member display name",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "description": "System role",
          "enum": ["admin", "doctor", "nurse", "receptionist"]
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 50
        }
      },
      "required": ["uid", "email", "role"]
    },
    "PatientActivityLog": {
      "title": "PatientActivityLog",
      "description": "Chronological audit log tracking modifications and updates made to patient records",
      "type": "object",
      "properties": {
        "patientDocId": {
          "type": "string",
          "description": "Firestore document ID of the associated patient",
          "maxLength": 64
        },
        "patientId": {
          "type": "string",
          "description": "Hospital Patient ID e.g. PAT-2026-001",
          "maxLength": 32
        },
        "action": {
          "type": "string",
          "description": "Type of action performed",
          "enum": ["CREATED", "UPDATED", "DELETED", "CLINICAL_UPDATE", "CONTACT_UPDATE", "NOTE_ADDED"]
        },
        "actorUid": {
          "type": "string",
          "description": "Auth UID of the staff or user who made the change",
          "maxLength": 128
        },
        "actorName": {
          "type": "string",
          "description": "Display name or email of the staff member",
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "description": "Brief description of the changes made",
          "maxLength": 300
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of the modification event",
          "maxLength": 50
        }
      },
      "required": ["patientDocId", "action", "actorName", "summary", "timestamp"]
    }
  },
  "firestore": {
    "/patients/{patientDocId}": {
      "schema": "Patient",
      "description": "Collection of patient health and demographic records"
    },
    "/patients/{patientDocId}/activityLogs/{logDocId}": {
      "schema": "PatientActivityLog",
      "description": "Chronological audit logs and update history for this specific patient"
    },
    "/doctors/{doctorDocId}": {
      "schema": "Doctor",
      "description": "Collection of hospital physicians and medical consultants"
    },
    "/appointments/{appointmentDocId}": {
      "schema": "Appointment",
      "description": "Collection of outpatient and inpatient appointments"
    },
    "/staff/{staffDocId}": {
      "schema": "StaffAdmin",
      "description": "Authorized hospital staff and administrators"
    }
  }
}

